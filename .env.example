# Copy to .env and fill locally. Never commit real secrets.

# API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
LOG_CONVERSATION_TEXT=false
REQUEST_BODY_LIMIT_BYTES=65536

# Data
# Absolute or repo-relative path to a locally downloaded Circa TSV/CSV.
# Leave empty to use bundled fixtures (synthetic, tests/demo only).
CIRCA_PATH=
DATASET_CACHE_DIR=data/cache

# Optional Hugging Face download (backend only)
HF_HOME=
HF_TOKEN=

# Optional LLM explanation provider (backend only; unused unless configured)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Frontend (public)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
